{
  "name": "varda",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/generate-pwa-icons.mjs && next dev --webpack",
    "build": "node scripts/generate-pwa-icons.mjs && next build --webpack && node scripts/build-sw-assets.mjs",
    "icons:generate": "node scripts/generate-pwa-icons.mjs",
    "start": "next start",
    "lint": "oxlint .",
    "clean": "node -e \"require('fs').rmSync('.next',{recursive:true,force:true})\"",
    "typecheck": "tsc --noEmit",
    "setup:local": "node scripts/setup-local.mjs",
    "db:migrate": "node --env-file-if-exists=.env.local --import tsx scripts/migrate-auth.ts",
    "test:e2e": "playwright test",
    "lint:fix": "oxlint --fix .",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "test:unit": "node --import tsx --test tests/email-code.test.ts tests/reservations.test.ts tests/three-studio-render.test.ts",
    "test:auth": "node --import tsx --test tests/email-code.test.ts",
    "test:db": "node --import tsx --test tests/reservations.test.ts",
    "test:postgres": "node --import tsx --test tests/postgres-integration.test.ts"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.10.0",
    "@phosphor-icons/react": "^2.1.10",
    "@vercel/analytics": "^2.0.1",
    "autoprefixer": "^10.6.2",
    "better-auth": "^1.7.14",
    "better-sqlite3": "^13.0.3",
    "clsx": "^2.1.1",
    "lucide-react": "^1.62.0",
    "motion": "^14.6.0",
    "next": "^16.4.3",
    "pg": "8.23.1",
    "postcss": "^8.5.32",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@next/eslint-plugin-next": "16.4.3",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@tailwindcss/typography": "^0.5.20",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "oxfmt": "0.75.0",
    "oxlint": "1.90.0",
    "sharp": "^0.35.5",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.15",
    "tw-animate-css": "^1.4.0",
    "typescript": "~7.0.2"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
