# Local accounts: npm run setup:local generates .env.local and creates the database.
# Never commit .env.local or your database. Use a unique secret in each environment.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
AUTH_DATABASE_PATH=.data/varda.sqlite

# For deployment, point AUTH_DATABASE_PATH at a persistent writable volume.
# Serverless hosts need a durable database adapter; see README.md.
APP_URL=http://localhost:3000

# Optional sandbox checkout. No real payment is confirmed by this app.
PAYFAST_SANDBOX=true
PAYFAST_MERCHANT_ID=
PAYFAST_MERCHANT_KEY=
PAYFAST_PASSPHRASE=
OZOW_SITE_CODE=
OZOW_PRIVATE_KEY=
OZOW_API_KEY=

# Optional passwordless email-code sign-in (off until all settings are configured).
# Verify the sender domain with Resend before enabling the UI.
# Never prefix the API key with NEXT_PUBLIC_.
VARDA_EMAIL_OTP_ENABLED=false
NEXT_PUBLIC_VARDA_EMAIL_OTP_ENABLED=false
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Database mode is explicit. Production rejects local/ephemeral SQLite account writes.
# Use the managed PostgreSQL DATABASE_URL from the Vercel database integration.
VARDA_DATABASE_DRIVER=sqlite
DATABASE_URL=
